          typeMap: 
            0: Kai
            1: Dit
            2: Seo
            3: Led
            4: Bel
            5: Tal
            6: Orh
            7: Anh
            8: Sol
    # Localize
    - name: MFTag
      group: 8
      type: 0
      arguments:
        - name: male
          dataType: str
        - name: female
          dataType: str
    - name: CAP
      group: 8
      type: 1
    - name: UNCAP
      group: 8
      type: 2
    - name: UNCAP_Release
      group: 8
      type: 3
    - name: UNCAPAll
      group: 8
      type: 4
    - name: UNCAPAll_End
      group: 8
      type: 5
    - name: CNthird
      group: 8
      type: 6
    - name: TWthird
      group: 8
      type: 7
