      type: Enum
      values: [None,Use_JP,Duplicate,Not_Recorded,Recorded,Under_Review,Delivered,Pickup,EN_Duplicate]
    - name: USen_Direction
      type: str
    - name: USen_Batch
      type: Enum
      values: [Null,Batch_1,Batch_2,Batch_3,Batch_4,Batch_5,Batch_7,Batch_8A,Batch_8B,Batch_9A,Batch_9B,Batch_10,Batch_ADR,TBD,Final_Pickups]
    - name: USen_Voice_Tech
