      type: str
    - name: PIDComment
      type: str
    - name: PIDComment_EN
      type: str
    - name: ExpressionComment_EN
      type: str
  tags:
    # System
    - name: Ruby
      description: ruby annotation rendered above the normal text
      group: 0
      type: 0
      arguments:
        - name: rt
          description: the annotation text
          dataType: str
    - name: Font
      group: 0
      type: 1
      arguments:
        - name: face
          dataType: str
    - name: Size
      description: changes the current text size
      group: 0
      type: 2
      arguments:
        - name: percent
          description: relative text size in percent
          dataType: u16
        - name: size
          description: relative text size
          dataType: str
    - name: Color
      description: Changes the current text color
      group: 0
      type: 3
      arguments:
        - name: name
          description: id of the color
          dataType: s16
          valueMap:
            0: SystemText
            1: SystemBG
            2: TalkText
            3: TalkBG
            4: AccentText
            5: MonologueText
            255: Default
    - name: pageBreak
      description: forces a new dialog page
      group: 0
      type: 4
    - name: Reference
      description: Refer to a message
      group: 0
      type: 5
      arguments:
        - name: mstxt
          dataType: str
        - name: label
          dataType: str
        - name: lang
          dataType: str
    # Arg
    - name: Arg0
      group: 1
      type: 0
    - name: Arg1
      group: 1
      type: 1
    - name: Arg2
      group: 1
      type: 2
    - name: Arg3
      group: 1
      type: 3
    - name: Arg4
      group: 1
      type: 4
    - name: TalkArg0
      group: 1
      type: 5
    - name: TalkArg1
      group: 1
      type: 6
    - name: TalkArg2
      group: 1
      type: 7
    # Name
    - name: Hero
      group: 2
      type: 0
    - name: Route
      group: 2
      type: 1
    # Ebedded
    - name: Icon
      group: 3
      type: 0
      arguments:
        - name: name
          dataType: u8
    # SorM
    - name: SorMArg0
      group: 4
      type: 0
      arguments:
        - name: Single 
          dataType: str
        - name: Multi 
          dataType: str
    - name: SorMArg1
      group: 4
      type: 1
      arguments:
