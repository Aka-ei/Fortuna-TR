        - name: Multi 
          dataType: str
    - name: SorMArg3
      group: 4
      type: 3
      arguments:
        - name: Single 
          dataType: str
        - name: Multi 
          dataType: str
    - name: SorMArg4
      group: 4
      type: 4
      arguments:
        - name: Single 
          dataType: str
        - name: Multi 
          dataType: str
    - name: SorMTalkArg0
      group: 4
      type: 5
      arguments:
        - name: Single 
          dataType: str
        - name: Multi 
          dataType: str
    - name: SorMTalkArg1
      group: 4
      type: 6
      arguments:
        - name: Single 
          dataType: str
        - name: Multi 
          dataType: str
    - name: SorMTalkArg2
      group: 4
      type: 7
      arguments:
        - name: Single 
          dataType: str
        - name: Multi 
          dataType: str
    # PorN
    - name: PorNArg0
      group: 5
      type: 0
      arguments:
        - name: Positive 
          dataType: str
        - name: Negative
          dataType: str
    - name: PorNArg1
      group: 5
      type: 1
      arguments:
        - name: Positive 
          dataType: str
        - name: Negative
          dataType: str
    - name: PorNArg2
      group: 5
      type: 2
      arguments:
        - name: Positive 
          dataType: str
        - name: Negative
          dataType: str
    - name: PorNArg3
      group: 5
      type: 3
      arguments:
        - name: Positive 
          dataType: str
        - name: Negative
          dataType: str
    - name: PorNArg4
      group: 5
      type: 4
      arguments:
        - name: Positive 
          dataType: str
        - name: Negative
          dataType: str
    - name: PorNTalkArg0
      group: 5
      type: 5
      arguments:
        - name: Positive 
          dataType: str
        - name: Negative
          dataType: str
    - name: PorNTalkArg1
      group: 5
      type: 6
      arguments:
        - name: Positive 
          dataType: str
        - name: Negative
          dataType: str
    - name: PorNTalkArg2
      group: 5
      type: 7
      arguments:
        - name: Positive 
          dataType: str
        - name: Negative
          dataType: str
    
    # Article
    - name: ArticleArg0
      group: 6
      type: 0
    - name: ArticleArg1
      group: 6
      type: 1
    - name: ArticleArg2
      group: 6
      type: 2
    - name: ArticleArg3
      group: 6
      type: 3
    - name: ArticleArg4
      group: 6
      type: 4
    
    # DateTime
    - name: term_month
      group: 7
      type: 0
    - name: term_day
      group: 7
      type: 1
    - name: term_hour
      group: 7
      type: 2
    - name: term_minute
      group: 7
      type: 3
    - name: SideStory_month
      group: 7
      type: 4
      arguments:
        - name: character
          dataType: u8
          typeMap: 
            0: Kai
            1: Dit
            2: Seo
            3: Led
            4: Bel
            5: Tal
            6: Orh
            7: Anh
            8: Sol
    - name: SideStory_day
      group: 7
      type: 5
      arguments:
